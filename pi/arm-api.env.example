# Raspberry Pi 로봇팔 서버 설정. install.sh가 /etc/arm-api.env로 복사한다(권한 600, 토큰은 무작위로 채움).
# 빈 값은 "설정 안 함"이다(기본값 사용).

# 접속 토큰: 웹 화면 [설정]과 팀 NOMI의 ARM_API_TOKEN에 같은 값을 넣는다
ARM_API_TOKEN=
ARM_API_PORT=8000

# 노트북에서 도는 LLM(Ollama). 노트북 Ollama는 다른 컴퓨터 접속을 받도록 OLLAMA_HOST=0.0.0.0으로 켜야 한다
OLLAMA_HOST=
# 노트북에서 도는 음성 인식(scripts/stt_server.py). 비우면 Pi에서 Whisper를 돌린다(느림, faster-whisper 필요)
ARM_STT_URL=
ARM_STT_TOKEN=

# 장치 경로(비우면 기본값). 같은 USB 장치면 by-id 이름이 같아서 보통 비워 둔다. 확인: python scripts/check_devices.py
ARM_SERVO_PORT=
ARM_PUMP_PORT=
ARM_WRIST_CAMERA=
# Astra용 OpenNI2 런타임(libOpenNI2.so가 있는 폴더). Pi는 ARM64(aarch64) 빌드가 필요하다
ARM_OPENNI2_RUNTIME=
