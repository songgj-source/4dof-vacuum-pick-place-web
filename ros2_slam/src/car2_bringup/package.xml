<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car2_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and params to bring up the car2 robot (depth camera + car2_driver),
    build a map with slam_toolbox from a depth-camera-derived laser scan, and
    navigate a saved map with Nav2.
  </description>
  <maintainer email="perpet99@gmail.com">perpet</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>car2_driver</exec_depend>
  <exec_depend>openni2_camera</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- remote RTAB-Map mapping (robot_rgbd / rtabmap_mapping launch files) -->
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>image_transport_plugins</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>rtabmap_rviz_plugins</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
